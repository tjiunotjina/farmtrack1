
# Copy this file to .env in the backend folder.
# Never commit real secrets or production credentials.

# PostgreSQL connection string from Supabase or another PostgreSQL provider.
DATABASE_URL=

# Secret used to sign login tokens. Generate a long random value.
JWT_SECRET=

# Shared admin secret. Used by admin functions and the admin portal.
# Also protects the temporary manual-payment confirmation endpoint.
# Leave unset to disable protected admin endpoints that require it.
# Generate with: openssl rand -hex 32
ADMIN_SECRET=

# Accounting and invoice settings.
# Use \n for line breaks in EFT_DETAILS where supported.
EFT_DETAILS="Bank: \nAccount name: \nAccount number: \nBranch code: "
COMPANY_NAME=Tjiunotjina Mureti Tech
COMPANY_ADDRESS=
COMPANY_VAT_NUMBER=
SUPPORT_EMAIL=

# Public app URL for links in emails.
APP_URL=

# Email provider: log (default; sends nothing), brevo, or resend.
# Email is sent through the provider's HTTPS API, not SMTP.
MAIL_PROVIDER=log
MAIL_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Orutumbo
MAIL_REPLY_TO=
