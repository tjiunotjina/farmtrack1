# Copy this file to .env (same folder) and fill in your real values.
# .env is gitignored — never commit real secrets.

# Get this from Render: your Postgres database → "Connections" → External
# Database URL. Looks like:
# postgresql://user:password@host.frankfurt-postgres.render.com/dbname
DATABASE_URL=

# Any long random string — used to sign login tokens.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Shared secret for the temporary manual-payment-confirmation endpoint
# (POST /api/billing/admin/mark-paid) — this stands in for real payment
# webhooks until a gateway (Paystack/Flutterwave/PayFast) is connected.
# Generate one with: openssl rand -hex 32
# Leave unset to disable the endpoint entirely.
ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Admin and accounting (see DEPLOY_EMAIL_ACCOUNTING.md)
# ---------------------------------------------------------------------------
# Signs you in to the admin page. Use something long: 20+ random characters.
ADMIN_SECRET=

# Your bank details, shown on invoices and in the client area. Use \n for new
# lines in a .env file; on Render just type a multi-line value.
EFT_DETAILS="Bank: \nAccount name: \nAccount number: \nBranch code: "

# Printed on invoices. Leave blank anything that does not apply.
COMPANY_NAME=Tjiunotjina Mureti Tech
COMPANY_ADDRESS=
COMPANY_VAT_NUMBER=
SUPPORT_EMAIL=

# Your app's address, used for the buttons and links inside emails.
APP_URL=

# ---------------------------------------------------------------------------
# Email. Sent over HTTPS, because Render's free tier blocks SMTP.
# ---------------------------------------------------------------------------
# log    = send nothing, just record each email in the admin "Emails" tab (default)
# brevo  = send through Brevo's API
# resend = send through Resend's API
MAIL_PROVIDER=log
MAIL_API_KEY=
# Must be an address your provider has verified for sending.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Orutumbo
# Where customer replies go (optional).
MAIL_REPLY_TO=
