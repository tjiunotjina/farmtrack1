# Copy this file to .env (same folder) and fill in your real values.
# .env is gitignored — never commit real secrets.

# Get this from Render: your Postgres database → "Connections" → External
# Database URL. Looks like:
# postgresql://user:password@host.frankfurt-postgres.render.com/dbname
DATABASE_URL=

# Any long random string — used to sign login tokens.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Shared secret for the temporary manual-payment-confirmation endpoint
# (POST /api/billing/admin/mark-paid) — this stands in for real payment
# webhooks until a gateway (Paystack/Flutterwave/PayFast) is connected.
# Generate one with: openssl rand -hex 32
# Leave unset to disable the endpoint entirely.
ADMIN_SECRET=
